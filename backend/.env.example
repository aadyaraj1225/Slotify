# Server configuration
PORT=8000
HOST=127.0.0.1

# Allowed CORS origins (comma-separated list for local frontend dev)
# Default Vite dev server port is 5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database configuration (Supabase PostgreSQL / local PostgreSQL)
# Example connection strings (Do not commit real credentials):
# Direct connection: postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres
# Transaction pooler (Supavisor port 6543): postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/slotify_db

# Supabase Authentication Configuration
# Found under Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-minimum-32-chars
# Service role key is only needed on the backend for administrative role changes (e.g., coordinator provisioning)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Administrative secret key for internal/bootstrap coordinator provisioning endpoint
ADMIN_PROVISION_SECRET=your-strong-bootstrap-secret
